{
	"name": "opendeck-ajazz",
	"version": "0.1.0",
	"description": "Use stream controllers",
	"author": "mistweaverco and friends",
	"license": "GPL-3.0-or-later",
	"repository": "https://github.com/mistweaverco/opendeck-ajazz",
	"scripts": {
		"dev": "bun x --bun --no-install vite dev",
		"build": "bun x --bun --no-install vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write \"src/**/*.{ts,svelte,css,html}\" \"plugins/**/*.ts\" \"*.{js,ts,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,svelte,css,html}\" \"plugins/**/*.ts\" \"*.{js,ts,json}\"",
		"lint": "eslint .",
		"tauri": "bun x --bun --no-install tauri"
	},
	"devDependencies": {
		"@eslint/js": "^9.22",
		"@sveltejs/adapter-static": "^3.0",
		"@sveltejs/kit": "^2.21",
		"@sveltejs/vite-plugin-svelte": "^3.1",
		"@tailwindcss/vite": "^4.1",
		"@tauri-apps/cli": "2.8.3",
		"eslint": "^9.22",
		"eslint-config-prettier": "^10.1",
		"eslint-plugin-svelte": "^3.1",
		"globals": "^16.0",
		"lightningcss": "^1.30",
		"prettier": "^3.5",
		"prettier-plugin-svelte": "^3.3",
		"svelte": "^4.2",
		"svelte-check": "^4.2",
		"tailwindcss": "^4.1",
		"typescript": "^5.8",
		"typescript-eslint": "^8.26",
		"vite": "^5.4"
	},
	"packageManager": "bun@1.3.14",
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "2.8.0",
		"@tauri-apps/plugin-deep-link": "2.4.2",
		"@tauri-apps/plugin-dialog": "2.3.3",
		"dompurify": "^3.2",
		"marked": "^15.0",
		"marked-base-url": "^1.1",
		"phosphor-svelte": "^2.0"
	}
}
